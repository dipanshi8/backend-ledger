# Backend Ledger — environment configuration template
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
# TCP port the HTTP server listens on. Defaults to 3000 if not set.
PORT=3000

# Node environment. One of: development | production | test
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB connection string.
# For local development with a replica set (required for transactions):
#   MONGO_URI=mongodb://localhost:27017/backend-ledger?replicaSet=rs0
# For MongoDB Atlas:
#   MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/backend-ledger
MONGO_URI=mongodb://localhost:27017/backend-ledger?replicaSet=rs0

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens. Use a long random string.
# Example (do not use this value): openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (scheme + host + optional port).
# Example for local development with a React dev server on port 3001:
#   ALLOWED_ORIGINS=http://localhost:3001
# Example for production with multiple front-ends:
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# If left empty: test mode allows all origins; all other modes deny cross-origin requests.
ALLOWED_ORIGINS=http://localhost:3001

# ── Email notifications (optional — see src/services/email.service.js) ────────
# Gmail OAuth2 credentials for sending registration and transaction emails.
# Email delivery is best-effort; a failed email does not affect financial operations.
# Leave these blank to run without email notifications.
EMAIL_USER=your-gmail-address@gmail.com
CLIENT_ID=your-google-oauth2-client-id
CLIENT_SECRET=your-google-oauth2-client-secret
REFRESH_TOKEN=your-google-oauth2-refresh-token

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection string. Required for shared rate limiting and BullMQ email
# queue processing. All API instances must use the same Redis service to share
# rate-limit counters.
#
# Local development (install Redis or use Docker):
#   redis://localhost:6379
# Redis with TLS:
#   rediss://redis.example.com:6380
REDIS_URL=redis://localhost:6379

# ── Graceful shutdown ─────────────────────────────────────────────────────────
# Time in milliseconds the server waits for in-flight requests to finish before
# forcing a process exit. Defaults to 10000 (10 seconds).
SHUTDOWN_TIMEOUT_MS=10000

# ── Outbox dispatcher ─────────────────────────────────────────────────────────
# Polling interval in milliseconds for the notification outbox dispatcher.
# The dispatcher runs in the API server process and submits committed outbox
# events to BullMQ for async email delivery.
OUTBOX_POLL_INTERVAL_MS=10000
